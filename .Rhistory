# Metode Numerik
# Interpolasi Lagrange
x <- c(1, 2, 4, 5)
y <- c(2, 5, 8, 10)
lagrange <- function(x, y, xp) {
n <- length(x)
yp <- 0
for (i in 1:n) {
L <- 1
for (j in 1:n) {
if (i != j) {
L <- L * (xp - x[j]) / (x[i] - x[j])
}
}
yp <- yp + y[i] * L
}
return(yp)
}
lagrange(x, y, 3)
# Menghitung pendekatan sin(x) dengan Deret Taylor
x <- 1 # Nilai awal x
# Rumus Deret Taylor
sin_taylor <- x - (x^3 / factorial(3)) + (x^5 / factorial(5)) - (x^7 / factorial(7))
print(sin_taylor)
# Menghitung pendekatan sin(x) dengan Deret Taylor
x <- 0.5 # Nilai awal x
# Rumus Deret Taylor
sin_taylor <- x - (x^3 / factorial(3)) + (x^5 / factorial(5)) - (x^7 / factorial(7))
print(sin_taylor)
